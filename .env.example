# ============================================
# Document & Notification Service Configuration
# ============================================

# Environment
RUST_LOG=info
ENVIRONMENT=development

# ============================================
# Server Configuration
# ============================================
PDF_SERVER_HOST=0.0.0.0
PDF_SERVER_PORT=8080
PDF_SERVER_WORKERS=4
PDF_SERVER_MAX_CONNECTIONS=5000
PDF_SERVER_TIMEOUT_MS=30000

# ============================================
# Database Configuration (SQLite)
# ============================================
PDF_DATABASE_PATH=data/app.db
PDF_DATABASE_MAX_CONNECTIONS=5
PDF_DATABASE_MIN_CONNECTIONS=1
PDF_DATABASE_CONNECTION_TIMEOUT_SECONDS=30
PDF_DATABASE_IDLE_TIMEOUT_SECONDS=600
PDF_DATABASE_WAL_MODE=true

# ============================================
# Kafka Configuration
# ============================================
PDF_KAFKA_BROKERS=localhost:9092
PDF_KAFKA_GROUP_ID=document-service
PDF_KAFKA_CLIENT_ID=document-service-01

# Kafka Topics
PDF_KAFKA_TOPICS_DOCUMENT_REQUEST=document-generate-request
PDF_KAFKA_TOPICS_DOCUMENT_BATCH=document-batch-request
PDF_KAFKA_TOPICS_NOTIFICATION_DISPATCH=notification-dispatch-request
PDF_KAFKA_TOPICS_EVENTS=document-events
PDF_KAFKA_TOPICS_DLQ=document-dlq

# Kafka Security (Optional)
# PDF_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PDF_KAFKA_SECURITY_SASL_MECHANISM=PLAIN
# PDF_KAFKA_SECURITY_SASL_USERNAME=
# PDF_KAFKA_SECURITY_SASL_PASSWORD=

# ============================================
# Storage Configuration (Cloudflare R2)
# ============================================
PDF_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
PDF_STORAGE_BUCKET=documents
PDF_STORAGE_REGION=auto
PDF_STORAGE_ACCESS_KEY_ID=your-r2-access-key
PDF_STORAGE_SECRET_ACCESS_KEY=your-r2-secret-key
PDF_STORAGE_URL_EXPIRY_SECONDS=3600

# ============================================
# Cache Configuration (In-Memory)
# ============================================
PDF_CACHE_MAX_CAPACITY=10000
PDF_CACHE_TIME_TO_LIVE_SECONDS=3600
PDF_CACHE_TIME_TO_IDLE_SECONDS=600

# ============================================
# Email Configuration (SMTP)
# ============================================
PDF_NOTIFICATION_EMAIL_SMTP_HOST=smtp.gmail.com
PDF_NOTIFICATION_EMAIL_SMTP_PORT=587
PDF_NOTIFICATION_EMAIL_SMTP_USERNAME=your-email@gmail.com
PDF_NOTIFICATION_EMAIL_SMTP_PASSWORD=your-app-password
PDF_NOTIFICATION_EMAIL_FROM_EMAIL=noreply@facturazo.com
PDF_NOTIFICATION_EMAIL_FROM_NAME=Facturazo
PDF_NOTIFICATION_EMAIL_USE_TLS=true

# ============================================
# WhatsApp Configuration (EvolutionAPI)
# ============================================
# Testing Environment (DO NOT USE IN PRODUCTION)
PDF_NOTIFICATION_WHATSAPP_API_URL=http://5.161.120.166:8080
PDF_NOTIFICATION_WHATSAPP_API_KEY=mySuperSecretKey123
PDF_NOTIFICATION_WHATSAPP_INSTANCE_NAME=FACTURAZO-ERP-DEV
PDF_NOTIFICATION_WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhooks/whatsapp

# Production values (replace with your own)
# PDF_NOTIFICATION_WHATSAPP_API_URL=https://your-evolution-api.com
# PDF_NOTIFICATION_WHATSAPP_API_KEY=your-secure-api-key
# PDF_NOTIFICATION_WHATSAPP_INSTANCE_NAME=your-instance-name

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=document-service

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=20

# ============================================
# Monitoring (Optional)
# ============================================
# OPENTELEMETRY_ENABLED=false
# OPENTELEMETRY_ENDPOINT=http://localhost:4317
# PROMETHEUS_METRICS_PORT=9090

# ============================================
# Feature Flags
# ============================================
FEATURE_EVOLUTION_API=true
FEATURE_TELEMETRY=false