# ============================================
# PDF Services - Environment Configuration
# ============================================

# === Logging ===
RUST_LOG=info

# === Server ===
HOST=0.0.0.0
PORT=8080

# === AWS S3 / Cloudflare R2 ===
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# S3 Buckets
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_TEMP=temp-uploads

# Optional: CDN URL (if you have a CDN in front of S3)
# CDN_URL=https://cdn.yourdomain.com

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# === File Limits ===
MAX_SYNC_SIZE_BYTES=1048576        # 1MB
MAX_UPLOAD_SIZE_BYTES=104857600    # 100MB
SYNC_TIMEOUT_MS=5000
ENABLE_COMPRESSION=true

# ============================================
# Email SMTP Configuration (Optional)
# ============================================
# All three required to enable email service:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your Company Name

# ============================================
# WhatsApp EvolutionAPI Configuration (Optional)
# ============================================
# All three required to enable WhatsApp service:
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE=your-instance-name
